{
	"name": "scrymox",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"format": "prettier --write .",
		"lint": "prettier --check . && npx eslint .",
		"check:types": "svelte-check --tsconfig ./jsconfig.json",
